# Save points hold ONLY the tools' source code and notes, and the workbench's own files.
# This is an allowlist: everything is left out unless it is named below, so documents,
# data, samples, backups, secrets, downloaded tools and build output never enter a save point.
# (A second layer: .workbench/scripts/save.ts saves an explicit list of files.)
/*

!/.gitignore
!/.gitattributes
!/AGENTS.md

# The workbench's own files: named files, and only text file types in the skill folder.
!/.codex/
/.codex/*
!/.codex/hooks.json
!/.codex/hooks/
/.codex/hooks/*
!/.codex/hooks/session-start.ps1
!/.codex/hooks/session-start.sh
!/.agents/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/workbench/
/.agents/skills/workbench/**/*.*
!/.agents/skills/workbench/**/*.md
!/.agents/skills/workbench/**/*.ts
!/.agents/skills/workbench/**/*.tsx
!/.agents/skills/workbench/**/*.jsonc
!/.agents/skills/workbench/**/*.txt
!/.agents/skills/workbench/**/*.mts
!/.agents/skills/workbench/**/*.mjs
!/.agents/skills/workbench/**/*.css
!/.agents/skills/workbench/**/*.html
!/.agents/skills/workbench/starters/*/package.json
!/.agents/skills/workbench/starters/*/package-lock.json
!/.agents/skills/workbench/starters/*/tsconfig.json
!/.agents/skills/workbench/starters/*/components.json
!/.agents/skills/workbench/starters/web/public/**/*.json
!/.agents/skills/impeccable/
/.agents/skills/impeccable/**/*.*
/.agents/skills/impeccable/scripts/bin/
!/.agents/skills/impeccable/**/*.md
!/.agents/skills/impeccable/**/*.json
!/.agents/skills/impeccable/**/*.toml
!/.agents/skills/impeccable/**/*.yaml
!/.agents/skills/impeccable/**/*.js
!/.agents/skills/impeccable/**/*.cmd
!/.impeccable/
/.impeccable/*
!/.impeccable/config.json
!/.workbench/
/.workbench/*
!/.workbench/scripts/
/.workbench/scripts/*
!/.workbench/scripts/bootstrap.ps1
!/.workbench/scripts/run.cmd
!/.workbench/scripts/git.cmd
!/.workbench/scripts/account.ps1
!/.workbench/scripts/account.sh
!/.workbench/session-brief.md
!/.workbench/NOTES.md
!/.workbench/VERSION
!/.workbench/scripts/save.ts
!/.workbench/scripts/try.ts
!/.workbench/scripts/data-map.ts
!/.workbench/scripts/update.ts
!/.workbench/account

# Each tool in tools/<name>/: its notes and words, named config files, and only code files
# inside app/src/ and app/test/. Never samples/, current/, out/ or node_modules/.
!/tools/
/tools/*/*
!/tools/*/NOTES.md
!/tools/*/CONTEXT.md
!/tools/*/PRODUCT.md
!/tools/*/DESIGN.md
!/tools/*/.impeccable/
/tools/*/.impeccable/*
!/tools/*/.impeccable/config.json
!/tools/*/.impeccable/design.json
!/tools/*/.impeccable/surfaces/
!/tools/*/.impeccable/critique/
/tools/*/.impeccable/surfaces/*
/tools/*/.impeccable/critique/*
!/tools/*/.impeccable/surfaces/*.md
!/tools/*/.impeccable/critique/*.md
!/tools/*/app/
/tools/*/app/*
!/tools/*/app/package.json
!/tools/*/app/package-lock.json
!/tools/*/app/tsconfig.json
!/tools/*/app/index.html
!/tools/*/app/build.mjs
!/tools/*/app/forge.config.ts
!/tools/*/app/forge.env.d.ts
!/tools/*/app/vite.main.config.mts
!/tools/*/app/vite.preload.config.mts
!/tools/*/app/vite.renderer.config.mts
!/tools/*/app/vite.config.ts
!/tools/*/app/wrangler.jsonc
!/tools/*/app/components.json
!/tools/*/app/README.md
!/tools/*/app/src/
!/tools/*/app/test/
!/tools/*/app/scripts/
/tools/*/app/scripts/*
!/tools/*/app/scripts/*.mjs
!/tools/*/app/public/
/tools/*/app/public/**/*.*
!/tools/*/app/public/**/*.txt
!/tools/*/app/public/**/*.xml
!/tools/*/app/public/**/*.json
!/tools/*/app/public/**/*.svg
!/tools/*/app/public/**/*.png
!/tools/*/app/public/**/*.jpg
!/tools/*/app/public/**/*.jpeg
!/tools/*/app/public/**/*.webp
!/tools/*/app/public/**/*.ico
!/tools/*/app/public/**/*.webmanifest
/tools/*/app/src/**/*.*
/tools/*/app/test/**/*.*
!/tools/*/app/src/**/*.ts
!/tools/*/app/src/**/*.tsx
!/tools/*/app/src/**/*.mts
!/tools/*/app/src/**/*.mjs
!/tools/*/app/src/**/*.css
!/tools/*/app/src/**/*.html
!/tools/*/app/test/**/*.ts
!/tools/*/app/test/**/*.mjs
