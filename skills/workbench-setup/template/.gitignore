# Save points hold ONLY the tool's source code and the workbench's own files.
# This is an allowlist: everything is left out unless it is named below, so documents,
# data, samples, backups, secrets, downloaded tools and build output never enter a save point.
/*

!/.gitignore
!/.gitattributes
!/AGENTS.md
!/CONTEXT.md

# The workbench's own files: named files, and only text file types in the skill folder.
!/.codex/
/.codex/*
!/.codex/hooks.json
!/.codex/hooks/
/.codex/hooks/*
!/.codex/hooks/session-start.ps1
!/.codex/hooks/session-start.sh
!/.agents/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/workbench/
/.agents/skills/workbench/**/*.*
!/.agents/skills/workbench/**/*.md
!/.agents/skills/workbench/**/*.ts
!/.agents/skills/workbench/**/*.mts
!/.agents/skills/workbench/**/*.mjs
!/.agents/skills/workbench/**/*.css
!/.agents/skills/workbench/**/*.html
!/.agents/skills/workbench/starter/package.json
!/.agents/skills/workbench/starter/package-lock.json
!/.agents/skills/workbench/starter/tsconfig.json
!/.workbench/
/.workbench/*
!/.workbench/scripts/
/.workbench/scripts/*
!/.workbench/scripts/bootstrap.ps1
!/.workbench/scripts/run.cmd
!/.workbench/scripts/git.cmd
!/.workbench/scripts/account.ps1
!/.workbench/scripts/account.sh
!/.workbench/session-brief.md
!/.workbench/NOTES.md
!/.workbench/VERSION
!/.workbench/account

# The tool: named config files, and only code files inside src/ and test/.
!/app/
/app/*
!/app/package.json
!/app/package-lock.json
!/app/tsconfig.json
!/app/index.html
!/app/forge.config.ts
!/app/forge.env.d.ts
!/app/vite.main.config.mts
!/app/vite.preload.config.mts
!/app/vite.renderer.config.mts
!/app/README.md
!/app/src/
!/app/test/
/app/src/**/*.*
/app/test/**/*.*
!/app/src/**/*.ts
!/app/src/**/*.css
!/app/src/**/*.html
!/app/test/**/*.ts
!/app/test/**/*.mjs
