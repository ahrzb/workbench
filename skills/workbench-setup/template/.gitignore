# Save points hold ONLY the tools' source code and notes, and the workbench's own files.
# This is an allowlist: everything is left out unless it is named below, so documents,
# data, samples, backups, secrets, downloaded tools and build output never enter a save point.
# (A second layer: .workbench/scripts/save.ps1 and save.sh save an explicit list of files.)
/*

!/.gitignore
!/.gitattributes
!/AGENTS.md

# The workbench's own files: named files, and only text file types in the skill folder.
!/.codex/
/.codex/*
!/.codex/hooks.json
!/.codex/hooks/
/.codex/hooks/*
!/.codex/hooks/session-start.ps1
!/.codex/hooks/session-start.sh
!/.agents/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/workbench/
/.agents/skills/workbench/**/*.*
!/.agents/skills/workbench/**/*.md
!/.agents/skills/workbench/**/*.ts
!/.agents/skills/workbench/**/*.mts
!/.agents/skills/workbench/**/*.mjs
!/.agents/skills/workbench/**/*.css
!/.agents/skills/workbench/**/*.html
!/.agents/skills/workbench/starters/*/package.json
!/.agents/skills/workbench/starters/*/package-lock.json
!/.agents/skills/workbench/starters/*/tsconfig.json
!/.workbench/
/.workbench/*
!/.workbench/scripts/
/.workbench/scripts/*
!/.workbench/scripts/bootstrap.ps1
!/.workbench/scripts/run.cmd
!/.workbench/scripts/git.cmd
!/.workbench/scripts/account.ps1
!/.workbench/scripts/account.sh
!/.workbench/session-brief.md
!/.workbench/NOTES.md
!/.workbench/VERSION
!/.workbench/scripts/save.ps1
!/.workbench/scripts/save.sh
!/.workbench/account

# Each tool in tools/<name>/: its notes and words, named config files, and only code files
# inside app/src/ and app/test/. Never samples/, current/, out/ or node_modules/.
!/tools/
/tools/*/*
!/tools/*/NOTES.md
!/tools/*/CONTEXT.md
!/tools/*/app/
/tools/*/app/*
!/tools/*/app/package.json
!/tools/*/app/package-lock.json
!/tools/*/app/tsconfig.json
!/tools/*/app/index.html
!/tools/*/app/build.mjs
!/tools/*/app/forge.config.ts
!/tools/*/app/forge.env.d.ts
!/tools/*/app/vite.main.config.mts
!/tools/*/app/vite.preload.config.mts
!/tools/*/app/vite.renderer.config.mts
!/tools/*/app/README.md
!/tools/*/app/src/
!/tools/*/app/test/
/tools/*/app/src/**/*.*
/tools/*/app/test/**/*.*
!/tools/*/app/src/**/*.ts
!/tools/*/app/src/**/*.mts
!/tools/*/app/src/**/*.mjs
!/tools/*/app/src/**/*.css
!/tools/*/app/src/**/*.html
!/tools/*/app/test/**/*.ts
!/tools/*/app/test/**/*.mjs
